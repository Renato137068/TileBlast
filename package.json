{
  "name": "tile-blast",
  "version": "1.0.0",
  "private": true,
  "description": "Tile Blast — puzzle game for Google Play",
  "scripts": {
    "sync:www": "node scripts/generate-icons.js && node scripts/sync-www.js",
    "icons": "node scripts/generate-icons.js",
    "serve:pwa": "npm run sync:www && npx --yes serve www -l 8080",
    "tunnel:pwa": "npx --yes cloudflared tunnel --url http://localhost:8080",
    "cap:sync": "npm run sync:www && npx cap sync android",
    "cap:sync:only": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android": "npm run cap:sync && npm run cap:open",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:boot": "vitest run tests/integration/boot.test.js",
    "test:e2e": "npm run sync:www && node scripts/run-e2e.mjs",
    "test:gameplay": "npm run sync:www && node tests/e2e/gameplay.mjs",
    "test:win": "npm run sync:www && node tests/e2e/win.mjs",
    "test:loss": "npm run sync:www && node tests/e2e/loss.mjs",
    "test:progress": "npm run sync:www && node tests/e2e/progress.mjs",
    "test:map": "npm run sync:www && node tests/e2e/map.mjs",
    "test:onboarding": "npm run sync:www && node tests/e2e/onboarding.mjs",
    "test:home-density": "npm run sync:www && node tests/e2e/home-density.mjs",
    "test:a11y": "npm run sync:www && node tests/e2e/a11y.mjs",
    "test:i18n:matrix": "npm run sync:www && node tests/e2e/i18n-matrix.mjs",
    "test:lifecycle": "npm run sync:www && node tests/e2e/lifecycle.mjs",
    "test:all": "npm test && npm run test:e2e",
    "build:www": "npm run sync:www && node scripts/minify-www.mjs",
    "build:release": "npm run sync:www && node scripts/minify-www.mjs && npm run cap:sync:only",
    "test:android": "cd android && gradlew connectedDebugAndroidTest",
    "play:prepublish": "node scripts/pre-publish.mjs",
    "play:validate": "node scripts/play-store-validate.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "release:gate:prod": "node scripts/release-gate.mjs --release --sync --report",
    "validate:versions": "npm run sync:www && node scripts/validate-versions.mjs",
    "audit": "node scripts/self-audit.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "content:validate:strict": "node scripts/validate-content.mjs --strict",
    "content:analyze": "node scripts/analyze-balance.mjs",
    "content:analyze:write": "node scripts/analyze-balance.mjs --write",
    "economy:simulate": "node scripts/simulate-economy.mjs",
    "content:expand": "node scripts/expand-worlds.js",
    "content:new-world": "node scripts/new-world.mjs",
    "play:assets": "node scripts/generate-icons.js && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-play-store-assets.ps1",
    "play:bundle": "npm run validate:versions && npm run release:gate:prod && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release-aab.ps1",
    "play:release": "npm run test:all && npm run play:assets && npm run play:bundle",
    "play:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-publish.ps1",
    "play:admob": "node scripts/apply-admob-ids.mjs",
    "ci:quality": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build:bundle && npm run content:validate && npm run play:validate && node scripts/release-gate.mjs --report",
    "ci:audit": "node scripts/self-audit.mjs --skip-tests --report",
    "play:screenshots": "node scripts/capture-store-screenshots.mjs",
    "play:feature-graphic": "node scripts/generate-feature-graphic.mjs",
    "format": "prettier --write \"**/*.{js,mjs}\" \"css/*.css\"",
    "format:check": "prettier --check \"**/*.{js,mjs}\" \"css/*.css\"",
    "build:bundle": "npm run sync:www && node scripts/build-bundle.mjs",
    "perf:budgets": "node scripts/check-perf-budgets.mjs",
    "perf:lab": "npm run sync:www && node scripts/run-perf-lab.mjs",
    "ui:shots": "npm run sync:www && node scripts/screenshot.mjs",
    "lint": "node scripts/lint-globals.mjs",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "build:prod": "npm run sync:www && node scripts/build-bundle.mjs && node scripts/bundle-www.mjs"
  },
  "capacitor": {
    "platforms": [
      "android"
    ]
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.12.1",
    "@capacitor/android": "^7.2.0",
    "@capacitor/cli": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/push-notifications": "^7.0.6",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.12.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "happy-dom": "^17.4.4",
    "prettier": "^3.9.5",
    "puppeteer": "^24.43.1",
    "sharp": "^0.34.5",
    "typescript": "~5.8.0",
    "vitest": "^3.0.9"
  }
}
