{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "allowJs": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "tb-game-logic.js",
    "tb-secure.js",
    "tb-save.js",
    "tb-economy.js",
    "tb-state.js",
    "tb-runtime.js",
    "tb-config.js",
    "tb-shop.js",
    "tb-result.js",
    "tb-map.js",
    "tb-board.js",
    "tb-xp.js",
    "tb-collection.js",
    "tb-chests.js",
    "tb-missions.js",
    "tb-events.js",
    "tb-challenges.js",
    "tb-meta-ui.js",
    "tb-gameplay.js",
    "tb-analytics.js",
    "tb-music.js",
    "tb-ads.js",
    "tb-dialogs.js",
    "tb-i18n.js",
    "tb-offers.js",
    "tb-achievements.js",
    "tb-social.js",
    "tb-retention.js",
    "tb-input.js",
    "tb-playbridge.js",
    "tb-start.js",
    "tb-grid.js",
    "tb-modes.js",
    "tb-a11y.js",
    "tb-fx.js",
    "tb-content.js"
  ],
  "exclude": [
    "node_modules",
    "www",
    "android",
    "tests",
    "scripts",
    "functions",
    "coverage"
  ]
}
