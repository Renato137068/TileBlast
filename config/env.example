# Configuração de ambiente Tile Blast (sem segredos)
#
# Copie valores reais para arquivos NÃO commitados:
#   play-store/console/IDS-PRODUCAO.env   (AdMob)
#   firebase-config.js                   (Firebase Web)
#   android/keystore.properties          (assinatura AAB)
#   functions/.env                       (Cloud Functions)
#
# Modos:
#   TB_ENV=development   → gate em modo DEV (placeholders = avisos)
#   TB_ENV=production    → gate em modo RELEASE (placeholders = falha)
#   TB_RELEASE=1         → força RELEASE (mesmo efeito)

TB_ENV=development

# Opcional: sobrescreve comportamento do gate
# TB_RELEASE=0
